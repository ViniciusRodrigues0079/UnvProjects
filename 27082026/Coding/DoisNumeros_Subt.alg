algoritmo "Dois Numeros Subtracao"

var

num1, num2, subt: inteiro

inicio

escreval("Informe um número inteiro: ")
leia(num1)
escreval("Informe outro número inteiro: ")
leia(num2)
subt <- num1 - num2
escreval("A subtração do seu primeiro número inteiro pelo segundo é igual a: ", subt)

fimalgoritmo